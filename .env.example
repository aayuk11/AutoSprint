# Copy this file to .env and fill in what you need.
# .env is gitignored. Never commit real values.
#
# The app runs with NO credentials at all - upload a Jira CSV export and
# download the reports. Credentials only unlock the optional integrations.

# --- Flask -------------------------------------------------------------------
# Any long random string; signs the session cookie. REQUIRED once APP_PASSWORD
# is set, otherwise a random key is generated at startup and everyone is signed
# out on every restart.  Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=8501

# --- Access control ----------------------------------------------------------
# Leave APP_PASSWORD empty to disable the login screen entirely (useful locally).
# Set it to switch the gate on: users sign in with any email on the allowed
# domain plus this shared password. Note the email is recorded, not verified -
# the password is the real control, so keep the app on an internal network.
APP_PASSWORD=
AUTH_EMAIL_DOMAIN=example.com
# Seed at least one address here. The in-app list starts empty and you must be
# signed in to edit it, so these are the way back in if the list is emptied.
AUTH_ALLOWED_EMAILS=you@example.com
SESSION_DAYS=7
# Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Jira (required for "Fetch from Jira") -----------------------------------
# An Atlassian API token, not your password:
#   https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Optional: pin the sprint date fields. If unset they are auto-discovered by
# name (Target start -> Start date, Target end -> Due date).
# JIRA_TARGET_START_FIELD=customfield_10015
# JIRA_TARGET_END_FIELD=customfield_10016

# --- Zoho Sheet (shared storage for projects, mappings, queries, channels) ----
# Without these the app falls back to local JSON files under data/, which do
# NOT survive a container restart.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_RESOURCE_ID=
# Your Zoho data centre: in / com / eu / au / jp
ZOHO_LOCATION=com
ZOHO_WORKSHEET_NAME=app_data

# --- Scheduled reports -------------------------------------------------------
# The app runs due reports on a timer inside the web process. Set to false in
# any environment that must NOT post. Keep the deployment at ONE replica with
# WEB_CONCURRENCY=1 while this is on.
SCHEDULER_ENABLED=true

# --- Zoho Cliq (required for "Post to Cliq") ---------------------------------
# Use a DEDICATED account, not a personal one, so posts aren't attributed to an
# individual. That account must be a member of every channel it posts to.
#
# Self-client scopes needed:
#   ZohoCliq.Channels.READ, ZohoCliq.Chats.ALL,
#   ZohoCliq.Messages.CREATE, ZohoCliq.Webhooks.CREATE
#
# Webhooks.CREATE is what the /files endpoints require. Without it the message
# posts fine and every file upload fails with oauthtoken_scope_invalid.
#
# One self-client can serve both ZOHO_* and CLIQ_* if it also holds the
# ZohoSheet.dataAPI scopes - posts are then attributed to that account.
CLIQ_CLIENT_ID=
CLIQ_CLIENT_SECRET=
CLIQ_REFRESH_TOKEN=
CLIQ_LOCATION=com
